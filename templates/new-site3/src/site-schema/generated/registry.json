    {
      "version": 1,
      "id": "menu.catalog",
      "type": "menu",
      "variant": "catalog",
      "contract": "./contract.schema.json",
      "definition": "./definition.tsx",
      "capability": {
        "title": "Menu Catalog",
        "description": "Filterable and sortable menu grid with a category tab row, a sort selector, a live result count and standardized dish cards. Renders one h2 and one h3 per visible dish name.",
        "useWhen": [
          "A menu page should let guests filter dishes by category and sort them"
        ],
        "avoidWhen": [
          "Only a small curated set of dishes should be shown (use a seasonal carousel)"
        ],
        "rendering": "client-island"
      },
      "schemaKey": "MenuCatalogSection",
      "contentFields": [
        {
          "name": "eyebrow",
          "required": true,
          "type": "string"
        },
        {
          "name": "title",
          "required": true,
          "type": "string",
          "description": "Rendered as this section's h2."
        },
        {
          "name": "description",
          "required": true,
          "type": "string"
        },
        {
          "name": "allLabel",
          "required": true,
          "type": "string",
          "description": "Label of the unfiltered category option, always rendered first."
        },
        {
          "name": "categories",
          "required": true,
          "type": "array"
        },
        {
          "name": "sorts",
          "required": true,
          "type": "array"
        },
        {
          "name": "dishes",
          "required": true,
          "type": "array"
        },
        {
          "name": "resultsLabel",
          "required": true,
          "type": "string",
          "description": "Unit noun for the visible result count, e.g. \"dishes\"."
        },
        {
          "name": "emptyState",
          "required": true,
          "type": "string"
        },
        {
          "name": "priceNote",
          "required": true,
          "type": "string"
        }
      ]
    },
