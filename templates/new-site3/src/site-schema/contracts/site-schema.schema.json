{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/site-schema/core",
  "title": "SiteDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["siteId", "siteUrl", "theme", "pages"],
  "properties": {
    "siteId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "siteUrl": { "type": "string", "pattern": "^https?://[^\\s]+$", "format": "uri" },
    "theme": { "$ref": "#/$defs/theme" },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fonts", "colors"],
      "properties": {
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["heading", "typography"],
          "properties": {
            "heading": { "enum": ["System Sans", "System Serif"] },
            "typography": { "enum": ["System Sans", "System Serif"] }
          }
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["background", "foreground", "card", "cardForeground", "popover", "popoverForeground", "primary", "primaryForeground", "secondary", "secondaryForeground", "muted", "mutedForeground", "accent", "accentForeground", "destructive", "destructiveForeground", "border", "input", "ring"],
          "properties": {
            "background": { "$ref": "#/$defs/color" },
            "foreground": { "$ref": "#/$defs/color" },
            "card": { "$ref": "#/$defs/color" },
            "cardForeground": { "$ref": "#/$defs/color" },
            "popover": { "$ref": "#/$defs/color" },
            "popoverForeground": { "$ref": "#/$defs/color" },
            "primary": { "$ref": "#/$defs/color" },
            "primaryForeground": { "$ref": "#/$defs/color" },
            "secondary": { "$ref": "#/$defs/color" },
            "secondaryForeground": { "$ref": "#/$defs/color" },
            "muted": { "$ref": "#/$defs/color" },
            "mutedForeground": { "$ref": "#/$defs/color" },
            "accent": { "$ref": "#/$defs/color" },
            "accentForeground": { "$ref": "#/$defs/color" },
            "destructive": { "$ref": "#/$defs/color" },
            "destructiveForeground": { "$ref": "#/$defs/color" },
            "border": { "$ref": "#/$defs/color" },
            "input": { "$ref": "#/$defs/color" },
            "ring": { "$ref": "#/$defs/color" }
          }
        }
      }
    },
    "color": { "type": "string", "pattern": "^(#[0-9A-Fa-f]{6}|hsl\\([0-9.]+ [0-9.]+% [0-9.]+%\\))$" },
    "page": {
      "title": "SitePage",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "metadata", "sections"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "sections": { "type": "array", "items": { "$ref": "#/$defs/section" } }
      }
    },
    "section": {
      "title": "SiteSection",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "variant", "content"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "content": { "type": "object" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalPath", "title", "description"],
      "properties": {
        "canonicalPath": { "type": "string", "pattern": "^/" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "robots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "follow"],
          "properties": { "index": { "type": "boolean" }, "follow": { "type": "boolean" } }
        },
        "openGraph": { "type": "object" },
        "structuredData": { "type": ["object", "array"] }
      }
    },
    "media": {
      "title": "SiteMedia",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "alt"],
      "properties": {
        "kind": { "const": "image" },
        "path": { "type": "string", "pattern": "^(\\/media\\/|https:\\/\\/)" },
        "alt": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "linkTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "pageId"],
          "properties": { "kind": { "const": "page" }, "pageId": { "type": "string", "minLength": 1 }, "fragment": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "href"],
          "properties": { "kind": { "const": "external" }, "href": { "type": "string", "pattern": "^https?://" } }
        }
      ]
    },
    "siteAction": {
      "title": "SiteAction",
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "target"],
      "properties": { "label": { "type": "string", "minLength": 1 }, "target": { "$ref": "#/$defs/linkTarget" } }
    }
  }
}
