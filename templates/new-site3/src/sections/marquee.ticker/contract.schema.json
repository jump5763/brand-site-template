{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/marquee.ticker",
  "title": "Marquee Ticker",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "items"],
  "properties": {
    "label": { "type": "string", "minLength": 1, "description": "Accessible name for the ticker region." },
    "items": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
  }
}
