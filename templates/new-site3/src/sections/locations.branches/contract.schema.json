{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/locations.branches",
  "title": "Store Locations",
  "type": "object",
  "additionalProperties": false,
  "required": ["eyebrow", "title", "description", "map", "branches", "note"],
  "properties": {
    "eyebrow": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "description": "Rendered as this section's h2." },
    "description": { "type": "string", "minLength": 1 },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "zoom", "title"],
      "properties": {
        "query": { "type": "string", "minLength": 1, "description": "Place query passed to the Google Maps embed." },
        "zoom": { "type": "integer", "minimum": 1, "maximum": 21 },
        "title": { "type": "string", "minLength": 1, "description": "Accessible title for the map frame." }
      }
    },
    "branches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/branch" } },
    "note": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "addressLine", "cityLine", "phone", "hours", "services"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "addressLine": { "type": "string", "minLength": 1 },
        "cityLine": { "type": "string", "minLength": 1 },
        "phone": { "type": "string", "minLength": 1 },
        "hours": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "services": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
