{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/menu.seasonal",
  "title": "Seasonal Favorites",
  "type": "object",
  "additionalProperties": false,
  "required": ["eyebrow", "title", "description", "action", "dishes"],
  "properties": {
    "eyebrow": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "description": "Rendered as this section's h2." },
    "description": { "type": "string", "minLength": 1 },
    "action": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
    "dishes": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/featuredDish" } }
  },
  "$defs": {
    "featuredDish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "price", "media"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "calories": { "type": "integer", "minimum": 0 },
        "badge": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "media": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media" }
      }
    }
  }
}
