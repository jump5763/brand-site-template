{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/home.hero",
  "title": "Home Hero",
  "type": "object",
  "additionalProperties": false,
  "required": ["eyebrow", "title", "description", "media", "primaryAction", "secondaryAction", "highlights", "scrollHint"],
  "properties": {
    "eyebrow": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "description": "Rendered as the page's single h1." },
    "description": { "type": "string", "minLength": 1 },
    "media": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media" },
    "primaryAction": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
    "secondaryAction": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
    "highlights": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/heroHighlight" } },
    "scrollHint": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "heroHighlight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
