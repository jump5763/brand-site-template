{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/site.footer",
  "title": "Site Footer",
  "type": "object",
  "additionalProperties": false,
  "required": ["brandName", "headline", "description", "columnTitles", "stores", "hours", "hoursNote", "explore", "contact", "legalNote"],
  "properties": {
    "brandName": { "type": "string", "minLength": 1 },
    "headline": { "type": "string", "minLength": 1, "description": "Brand statement rendered as this section's h2." },
    "description": { "type": "string", "minLength": 1 },
    "columnTitles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stores", "hours", "explore", "contact"],
      "properties": {
        "stores": { "type": "string", "minLength": 1 },
        "hours": { "type": "string", "minLength": 1 },
        "explore": { "type": "string", "minLength": 1 },
        "contact": { "type": "string", "minLength": 1 }
      }
    },
    "stores": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/footerStore" } },
    "hours": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hoursRow" } },
    "hoursNote": { "type": "string", "minLength": 1 },
    "explore": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/footerLink" } },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "phone", "social"],
      "properties": {
        "email": { "type": "string", "minLength": 3 },
        "phone": { "type": "string", "minLength": 1 },
        "social": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/socialLink" } }
      }
    },
    "legalNote": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "footerStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "addressLine", "cityLine", "phone"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "addressLine": { "type": "string", "minLength": 1 },
        "cityLine": { "type": "string", "minLength": 1 },
        "phone": { "type": "string", "minLength": 1 }
      }
    },
    "hoursRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "days", "time"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "days": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "minLength": 1 }
      }
    },
    "footerLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "target": { "$ref": "https://codeforma.local/site-schema/core#/$defs/linkTarget" }
      }
    },
    "socialLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "target": { "$ref": "https://codeforma.local/site-schema/core#/$defs/linkTarget" }
      }
    }
  }
}
