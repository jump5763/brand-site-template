{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/site-schema/generated",
  "title": "SiteDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "siteId",
    "siteUrl",
    "theme",
    "layout",
    "pages"
  ],
  "properties": {
    "siteId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "siteUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$",
      "format": "uri"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "layout": {
      "title": "SiteLayout",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "header": {
          "$ref": "#/$defs/headerSection"
        },
        "footer": {
          "$ref": "#/$defs/footerSection"
        }
      }
    },
    "pageSection": {
      "title": "SitePageSection",
      "oneOf": [
        {
          "$ref": "#/$defs/CarouselSignatureSection"
        },
        {
          "$ref": "#/$defs/ContactHoursSection"
        },
        {
          "$ref": "#/$defs/HeroPosterSection"
        },
        {
          "$ref": "#/$defs/IngredientsStorySection"
        },
        {
          "$ref": "#/$defs/LocationsStoresSection"
        },
        {
          "$ref": "#/$defs/MenuCatalogSection"
        },
        {
          "$ref": "#/$defs/MenuHeroSection"
        },
        {
          "$ref": "#/$defs/OrderChannelsSection"
        },
        {
          "$ref": "#/$defs/SeasonalGridSection"
        },
        {
          "$ref": "#/$defs/TestimonialsGridSection"
        }
      ]
    },
    "headerSection": {
      "title": "SiteHeaderSection",
      "oneOf": [
        {
          "$ref": "#/$defs/HeaderNavSection"
        }
      ]
    },
    "footerSection": {
      "title": "SiteFooterSection",
      "oneOf": [
        {
          "$ref": "#/$defs/FooterInfoSection"
        }
      ]
    },
    "fontName": {
      "title": "FontName",
      "type": "string",
      "enum": [
        "System Sans",
        "System Serif"
      ]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fonts",
        "colors"
      ],
      "properties": {
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "typography"
          ],
          "properties": {
            "heading": {
              "$ref": "#/$defs/fontName"
            },
            "typography": {
              "$ref": "#/$defs/fontName"
            }
          }
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "foreground",
            "card",
            "cardForeground",
            "popover",
            "popoverForeground",
            "primary",
            "primaryForeground",
            "secondary",
            "secondaryForeground",
            "muted",
            "mutedForeground",
            "accent",
            "accentForeground",
            "destructive",
            "destructiveForeground",
            "border",
            "input",
            "ring"
          ],
          "properties": {
            "background": {
              "$ref": "#/$defs/color"
            },
            "foreground": {
              "$ref": "#/$defs/color"
            },
            "card": {
              "$ref": "#/$defs/color"
            },
            "cardForeground": {
              "$ref": "#/$defs/color"
            },
            "popover": {
              "$ref": "#/$defs/color"
            },
            "popoverForeground": {
              "$ref": "#/$defs/color"
            },
            "primary": {
              "$ref": "#/$defs/color"
            },
            "primaryForeground": {
              "$ref": "#/$defs/color"
            },
            "secondary": {
              "$ref": "#/$defs/color"
            },
            "secondaryForeground": {
              "$ref": "#/$defs/color"
            },
            "muted": {
              "$ref": "#/$defs/color"
            },
            "mutedForeground": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "accentForeground": {
              "$ref": "#/$defs/color"
            },
            "destructive": {
              "$ref": "#/$defs/color"
            },
            "destructiveForeground": {
              "$ref": "#/$defs/color"
            },
            "border": {
              "$ref": "#/$defs/color"
            },
            "input": {
              "$ref": "#/$defs/color"
            },
            "ring": {
              "$ref": "#/$defs/color"
            }
          }
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "page": {
      "title": "SitePage",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "metadata",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pageSection"
          }
        }
      }
    },
    "section": {
      "title": "SiteSection",
      "oneOf": [
        {
          "$ref": "#/$defs/CarouselSignatureSection"
        },
        {
          "$ref": "#/$defs/ContactHoursSection"
        },
        {
          "$ref": "#/$defs/FooterInfoSection"
        },
        {
          "$ref": "#/$defs/HeaderNavSection"
        },
        {
          "$ref": "#/$defs/HeroPosterSection"
        },
        {
          "$ref": "#/$defs/IngredientsStorySection"
        },
        {
          "$ref": "#/$defs/LocationsStoresSection"
        },
        {
          "$ref": "#/$defs/MenuCatalogSection"
        },
        {
          "$ref": "#/$defs/MenuHeroSection"
        },
        {
          "$ref": "#/$defs/OrderChannelsSection"
        },
        {
          "$ref": "#/$defs/SeasonalGridSection"
        },
        {
          "$ref": "#/$defs/TestimonialsGridSection"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalPath",
        "title",
        "description"
      ],
      "properties": {
        "canonicalPath": {
          "type": "string",
          "pattern": "^/"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "robots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "follow"
          ],
          "properties": {
            "index": {
              "type": "boolean"
            },
            "follow": {
              "type": "boolean"
            }
          }
        },
        "openGraph": {
          "type": "object"
        },
        "structuredData": {
          "type": [
            "object",
            "array"
          ],
          "items": {
            "type": "object"
          }
        }
      }
    },
    "media": {
      "title": "SiteMedia",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "alt"
      ],
      "properties": {
        "kind": {
          "const": "image"
        },
        "path": {
          "type": "string",
          "pattern": "^(\\/media\\/|https:\\/\\/)"
        },
        "alt": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "linkTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pageId"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "pageId": {
              "type": "string",
              "minLength": 1
            },
            "fragment": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "href"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "href": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        }
      ]
    },
    "siteAction": {
      "title": "SiteAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "target"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/linkTarget"
        }
      }
    },
    "CarouselSignatureSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "carousel"
        },
        "variant": {
          "const": "signature"
        },
        "content": {
          "title": "Signature Dish Carousel",
          "type": "object",
          "required": [
            "eyebrow",
            "title",
            "description",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "$ref": "#/$defs/siteAction"
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "description",
                  "price",
                  "media"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "price": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  },
                  "media": {
                    "$ref": "#/$defs/media"
                  }
                }
              }
            }
          }
        }
      },
      "title": "CarouselSignatureSection"
    },
    "ContactHoursSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "contact"
        },
        "variant": {
          "const": "hours"
        },
        "content": {
          "title": "Contact & Hours",
          "type": "object",
          "required": [
            "eyebrow",
            "title",
            "description",
            "channels",
            "hours"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "hoursLabel": {
              "type": "string",
              "minLength": 1
            },
            "hoursNote": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "$ref": "#/$defs/siteAction"
            },
            "channels": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "channel",
                  "label",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "channel": {
                    "enum": [
                      "email",
                      "phone",
                      "catering"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "hours": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "days",
                  "time"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "days": {
                    "type": "string",
                    "minLength": 1
                  },
                  "time": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "title": "ContactHoursSection"
    },
    "FooterInfoSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "footer"
        },
        "variant": {
          "const": "info"
        },
        "content": {
          "title": "Site Footer",
          "type": "object",
          "required": [
            "brandName",
            "tagline",
            "columns",
            "contact",
            "hours",
            "copyright"
          ],
          "additionalProperties": false,
          "properties": {
            "brandName": {
              "type": "string",
              "minLength": 1
            },
            "tagline": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "copyright": {
              "type": "string",
              "minLength": 1
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "links"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "links": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "label",
                        "target"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "target": {
                          "$ref": "#/$defs/linkTarget"
                        }
                      }
                    }
                  }
                }
              }
            },
            "contact": {
              "type": "object",
              "required": [
                "title",
                "addressLines",
                "phone",
                "email"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "addressLines": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "phone": {
                  "type": "string",
                  "minLength": 1
                },
                "email": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "hours": {
              "type": "object",
              "required": [
                "title",
                "rows"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "days",
                      "time"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "days": {
                        "type": "string",
                        "minLength": 1
                      },
                      "time": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "title": "FooterInfoSection"
    },
    "HeaderNavSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "header"
        },
        "variant": {
          "const": "nav"
        },
        "content": {
          "title": "Site Header Navigation",
          "type": "object",
          "required": [
            "brandName",
            "items",
            "cta"
          ],
          "additionalProperties": false,
          "properties": {
            "brandName": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label",
                  "target"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target": {
                    "$ref": "#/$defs/linkTarget"
                  }
                }
              }
            },
            "cta": {
              "$ref": "#/$defs/siteAction"
            }
          }
        }
      },
      "title": "HeaderNavSection"
    },
    "HeroPosterSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "hero"
        },
        "variant": {
          "const": "poster"
        },
        "content": {
          "title": "Poster Hero",
          "type": "object",
          "required": [
            "eyebrow",
            "title",
            "description",
            "primaryAction",
            "media",
            "badges"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "primaryAction": {
              "$ref": "#/$defs/siteAction"
            },
            "secondaryAction": {
              "$ref": "#/$defs/siteAction"
            },
            "badges": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "media": {
              "$ref": "#/$defs/media"
            }
          }
        }
      },
      "title": "HeroPosterSection"
    },
    "IngredientsStorySection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "ingredients"
        },
        "variant": {
          "const": "story"
        },
        "content": {
          "title": "Farm Sourcing Story",
          "type": "object",
          "required": [
            "eyebrow",
            "title",
            "description",
            "media",
            "facts",
            "stats"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "media": {
              "$ref": "#/$defs/media"
            },
            "action": {
              "$ref": "#/$defs/siteAction"
            },
            "facts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "description"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "stats": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "value",
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "title": "IngredientsStorySection"
    },
    "LocationsStoresSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "locations"
        },
        "variant": {
          "const": "stores"
        },
        "content": {
          "title": "Store Locations & Map",
          "type": "object",
          "required": [
            "eyebrow",
            "title",
            "description",
            "map",
            "stores"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "map": {
              "type": "object",
              "required": [
                "query"
              ],
              "additionalProperties": false,
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1
                },
