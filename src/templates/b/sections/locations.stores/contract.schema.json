{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/locations.stores",
  "title": "Store Locations & Map",
  "type": "object",
  "required": ["eyebrow", "title", "description", "map", "stores"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "map": {
      "type": "object",
      "required": ["query"],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "zoom": { "type": "integer", "minimum": 1, "maximum": 21 }
      }
    },
    "stores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "addressLines", "phone", "hoursSummary", "media", "directions"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "addressLines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "phone": { "type": "string", "minLength": 1 },
          "hoursSummary": { "type": "string", "minLength": 1 },
          "media": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media" },
          "directions": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" }
        }
      }
    }
  }
}
