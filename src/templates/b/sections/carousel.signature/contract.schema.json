{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/carousel.signature",
  "title": "Signature Dish Carousel",
  "type": "object",
  "required": ["eyebrow", "title", "description", "items"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "action": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
    "items": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "price", "media"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "price": { "type": "number", "exclusiveMinimum": 0 },
          "tag": { "type": "string", "minLength": 1 },
          "media": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media" }
        }
      }
    }
  }
}
