{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/hero.poster",
  "title": "Poster Hero",
  "type": "object",
  "required": ["eyebrow", "title", "description", "primaryAction", "media", "badges"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "primaryAction": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
    "secondaryAction": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
    "badges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 } }
      }
    },
    "media": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media" }
  }
}
