{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/contact.hours",
  "title": "Contact & Hours",
  "type": "object",
  "required": ["eyebrow", "title", "description", "channels", "hours"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "hoursLabel": { "type": "string", "minLength": 1 },
    "hoursNote": { "type": "string", "minLength": 1 },
    "action": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "channel", "label", "value"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "channel": { "enum": ["email", "phone", "catering"] },
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hours": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "days", "time"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "days": { "type": "string", "minLength": 1 },
          "time": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
