{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/site-footer.default",
  "title": "Site Footer",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "variant", "content"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "site-footer" },
    "variant": { "const": "default" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brandName",
        "brandDescription",
        "orderAction",
        "newsletter",
        "navGroups",
        "stores",
        "hoursTitle",
        "hoursLines",
        "socialTitle",
        "social",
        "legalLinks",
        "copyright"
      ],
      "properties": {
        "brandName": { "type": "string", "minLength": 1 },
        "brandDescription": { "type": "string", "minLength": 1 },
        "orderAction": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
        "newsletter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "emailLabel",
            "placeholder",
            "submitLabel",
            "successMessage",
            "privacyNote"
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "emailLabel": { "type": "string", "minLength": 1 },
            "placeholder": { "type": "string", "minLength": 1 },
            "submitLabel": { "type": "string", "minLength": 1 },
            "successMessage": { "type": "string", "minLength": 1 },
            "privacyNote": { "type": "string", "minLength": 1 }
          }
        },
        "navGroups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "links"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "links": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "target"],
                  "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "target": { "$ref": "https://codeforma.local/site-schema/core#/$defs/linkTarget" }
                  }
                }
              }
            }
          }
        },
        "stores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "addressLines", "phone"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "addressLines": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "phone": { "type": "string", "minLength": 1 }
            }
          }
        },
        "hoursTitle": { "type": "string", "minLength": 1 },
        "hoursLines": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "socialTitle": { "type": "string", "minLength": 1 },
        "social": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "href"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "pattern": "^https://" }
            }
          }
        },
        "legalLinks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "target"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "target": { "$ref": "https://codeforma.local/site-schema/core#/$defs/linkTarget" }
            }
          }
        },
        "copyright": { "type": "string", "minLength": 1 }
      }
    }
  }
}
