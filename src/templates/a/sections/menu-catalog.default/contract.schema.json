{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/menu-catalog.default",
  "title": "Filterable Menu Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "variant", "content"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "menu-catalog" },
    "variant": { "const": "default" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "title",
        "description",
        "orderAction",
        "allLabel",
        "filterLabel",
        "clearLabel",
        "sortLabel",
        "resultLabel",
        "emptyMessage",
        "categories",
        "filters",
        "sortOptions",
        "items"
      ],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "orderAction": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
        "allLabel": { "type": "string", "minLength": 1 },
        "filterLabel": { "type": "string", "minLength": 1 },
        "clearLabel": { "type": "string", "minLength": 1 },
        "sortLabel": { "type": "string", "minLength": 1 },
        "resultLabel": { "type": "string", "minLength": 1 },
        "emptyMessage": { "type": "string", "minLength": 1 },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "blurb"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "blurb": { "type": "string", "minLength": 1 }
            }
          }
        },
        "filters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "sortOptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "description",
              "price",
              "calories",
              "category",
              "tags",
              "image"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "price": { "type": "number", "minimum": 0 },
              "calories": { "type": "integer", "minimum": 0 },
              "category": { "type": "string", "minLength": 1 },
              "tags": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "badge": { "type": "string", "minLength": 1 },
              "featured": { "type": "boolean" },
              "image": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media" }
            }
          }
        }
      }
    }
  }
}
