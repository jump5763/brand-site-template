{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/menu-intro.default",
  "title": "Menu Intro Banner",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "variant", "content"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "menu-intro" },
    "variant": { "const": "default" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "description", "meta", "image"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "meta": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "image": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media" }
      }
    }
  }
}
