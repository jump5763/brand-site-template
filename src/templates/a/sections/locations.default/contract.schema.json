{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/locations.default",
  "title": "Kitchen Locations",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "variant", "content"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "locations" },
    "variant": { "const": "default" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "description", "pickupNote", "stores", "map"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "pickupNote": { "type": "string", "minLength": 1 },
        "stores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "addressLines", "phone", "hours", "action"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "addressLines": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "phone": { "type": "string", "minLength": 1 },
              "hours": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["days", "time"],
                  "properties": {
                    "days": { "type": "string", "minLength": 1 },
                    "time": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "action": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" }
            }
          }
        },
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "query", "note"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "query": { "type": "string", "minLength": 1 },
            "note": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
