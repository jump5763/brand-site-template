{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/testimonials.default",
  "title": "Guest Reviews",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "variant", "content"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "testimonials" },
    "variant": { "const": "default" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "description", "items"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quote", "author", "meta", "rating"],
            "properties": {
              "quote": { "type": "string", "minLength": 1 },
              "author": { "type": "string", "minLength": 1 },
              "meta": { "type": "string", "minLength": 1 },
              "rating": { "type": "integer", "minimum": 1, "maximum": 5 }
            }
          }
        }
      }
    }
  }
}
