{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/hero.default",
  "title": "Full-Bleed Image Hero",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "variant", "content"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "hero" },
    "variant": { "const": "default" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "title",
        "description",
        "primaryAction",
        "secondaryAction",
        "badges",
        "image"
      ],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "primaryAction": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
        "secondaryAction": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
        "badges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "image": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media" }
      }
    }
  }
}
