{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/seasonal-picks.default",
  "title": "Seasonal Picks",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "variant", "content"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "seasonal-picks" },
    "variant": { "const": "default" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "description", "action", "items"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "action": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "price", "image"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "price": { "type": "string", "minLength": 1 },
              "badge": { "type": "string", "minLength": 1 },
              "image": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media" }
            }
          }
        }
      }
    }
  }
}
