{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/contact.default",
  "title": "Contact & Message Form",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "variant", "content"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "contact" },
    "variant": { "const": "default" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "description", "channels", "form"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value", "href", "note"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "minLength": 1 },
              "note": { "type": "string", "minLength": 1 }
            }
          }
        },
        "form": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "nameLabel",
            "namePlaceholder",
            "emailLabel",
            "emailPlaceholder",
            "topicLabel",
            "topicPlaceholder",
            "topics",
            "messageLabel",
            "messagePlaceholder",
            "submitLabel",
            "successMessage",
            "privacyNote"
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "nameLabel": { "type": "string", "minLength": 1 },
            "namePlaceholder": { "type": "string", "minLength": 1 },
            "emailLabel": { "type": "string", "minLength": 1 },
            "emailPlaceholder": { "type": "string", "minLength": 1 },
            "topicLabel": { "type": "string", "minLength": 1 },
            "topicPlaceholder": { "type": "string", "minLength": 1 },
            "topics": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "messageLabel": { "type": "string", "minLength": 1 },
            "messagePlaceholder": { "type": "string", "minLength": 1 },
            "submitLabel": { "type": "string", "minLength": 1 },
            "successMessage": { "type": "string", "minLength": 1 },
            "privacyNote": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
